\begin{MintedVerbatim}[commandchars=\\\{\}]
    \PYG{k}{def}\PYG{+w}{ }\PYG{n+nf}{text\PYGZus{}embedding}\PYG{p}{(}\PYG{n+nb+bp}{self}\PYG{p}{,} \PYG{n}{text\PYGZus{}ids}\PYG{o}{=}\PYG{k+kc}{None}\PYG{p}{,} \PYG{n}{text\PYGZus{}length}\PYG{o}{=}\PYG{k+kc}{None}\PYG{p}{):}
\PYG{+w}{        }\PYG{l+s+sd}{\PYGZdq{}\PYGZdq{}\PYGZdq{}text\PYGZus{}ids: (B, 100), text\PYGZus{}length: (B,).}
\PYG{l+s+sd}{           returns: (B, 1024, 1) embeddings textuales.\PYGZdq{}\PYGZdq{}\PYGZdq{}}

        \PYG{c+c1}{\PYGZsh{} PASO 1: Pasar por la red de lenguaje}
        \PYG{c+c1}{\PYGZsh{} Salida de GRULanguageNetwork:}
        \PYG{c+c1}{\PYGZsh{} Entrada:  (B, 100)         tokens BERT}
        \PYG{c+c1}{\PYGZsh{}   Embedding: (B, 100, 512)}
        \PYG{c+c1}{\PYGZsh{}   BiGRU:     (B, 100, 2048) bidireccional}
        \PYG{c+c1}{\PYGZsh{}   avg f+b:   (B, 100, 1024) promedio de fwd + bwd}
        \PYG{c+c1}{\PYGZsh{}   permute:   (B, 1024, 100, 1)}
        \PYG{n}{textual\PYGZus{}features} \PYG{o}{=} \PYG{n+nb+bp}{self}\PYG{o}{.}\PYG{n}{language\PYGZus{}network}\PYG{p}{(}\PYG{n}{text\PYGZus{}ids}\PYG{p}{,} \PYG{n}{text\PYGZus{}length}\PYG{p}{)}

        \PYG{c+c1}{\PYGZsh{} PASO 2: Max\PYGZhy{}pooling sobre la dim de tokens (dim=2)}
        \PYG{c+c1}{\PYGZsh{} Para cada canal (1024), tomar el valor máximo sobre los 100 tokens}
        \PYG{c+c1}{\PYGZsh{} Entrada: (B, 1024, 100, 1)}
        \PYG{c+c1}{\PYGZsh{} Salida:  (B, 1024, 1, 1)}
        \PYG{n}{textual\PYGZus{}features}\PYG{p}{,} \PYG{n}{\PYGZus{}} \PYG{o}{=} \PYG{n}{torch}\PYG{o}{.}\PYG{n}{max}\PYG{p}{(}\PYG{n}{textual\PYGZus{}features}\PYG{p}{,} \PYG{n}{dim}\PYG{o}{=}\PYG{l+m+mi}{2}\PYG{p}{,} \PYG{n}{keepdim}\PYG{o}{=}\PYG{k+kc}{True}\PYG{p}{)}

        \PYG{c+c1}{\PYGZsh{} PASO 3: DSC compartido con la rama visual}
        \PYG{n}{textual\PYGZus{}features} \PYG{o}{=} \PYG{n+nb+bp}{self}\PYG{o}{.}\PYG{n}{depthwise\PYGZus{}seperable\PYGZus{}convolution}\PYG{p}{(}\PYG{n}{textual\PYGZus{}features}\PYG{p}{)}

        \PYG{c+c1}{\PYGZsh{} PASO 4: squeeze + contiguous}
        \PYG{n}{textual\PYGZus{}features} \PYG{o}{=} \PYG{n}{textual\PYGZus{}features}\PYG{o}{.}\PYG{n}{squeeze}\PYG{p}{(}\PYG{o}{\PYGZhy{}}\PYG{l+m+mi}{1}\PYG{p}{)}\PYG{o}{.}\PYG{n}{contiguous}\PYG{p}{()}
        \PYG{k}{return} \PYG{n}{textual\PYGZus{}features}
\end{MintedVerbatim}
