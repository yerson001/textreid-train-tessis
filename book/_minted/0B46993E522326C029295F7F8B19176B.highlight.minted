\PYG{k}{def}\PYG{+w}{ }\PYG{n+nf}{calculate\PYGZus{}similarity}\PYG{p}{(}\PYG{n}{image\PYGZus{}feature\PYGZus{}local}\PYG{p}{,} \PYG{n}{text\PYGZus{}feature\PYGZus{}local}\PYG{p}{):}
\PYG{+w}{    }\PYG{l+s+sd}{\PYGZdq{}\PYGZdq{}\PYGZdq{}image: (N\PYGZus{}img, 1024), text: (N\PYGZus{}txt, 1024)}
\PYG{l+s+sd}{       returns: (N\PYGZus{}img, N\PYGZus{}txt) numpy array de similitudes coseno\PYGZdq{}\PYGZdq{}\PYGZdq{}}

    \PYG{c+c1}{\PYGZsh{} Aplanar por si tienen más dims}
    \PYG{n}{image\PYGZus{}feature\PYGZus{}local} \PYG{o}{=} \PYG{n}{image\PYGZus{}feature\PYGZus{}local}\PYG{o}{.}\PYG{n}{view}\PYG{p}{(}\PYG{n}{image\PYGZus{}feature\PYGZus{}local}\PYG{o}{.}\PYG{n}{size}\PYG{p}{(}\PYG{l+m+mi}{0}\PYG{p}{),} \PYG{o}{\PYGZhy{}}\PYG{l+m+mi}{1}\PYG{p}{)}
