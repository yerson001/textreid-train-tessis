\begin{MintedVerbatim}[commandchars=\\\{\}]
\PYG{k}{def}\PYG{+w}{ }\PYG{n+nf}{calculate\PYGZus{}similarity}\PYG{p}{(}\PYG{n}{image\PYGZus{}embedding}\PYG{p}{,} \PYG{n}{text\PYGZus{}embedding}\PYG{p}{):}
\PYG{+w}{    }\PYG{l+s+sd}{\PYGZdq{}\PYGZdq{}\PYGZdq{}Calcula la matriz de similitud coseno entre imágenes y textos.\PYGZdq{}\PYGZdq{}\PYGZdq{}}

    \PYG{c+c1}{\PYGZsh{} Aplanar embeddings a (B, 1024) por si vienen con más dims}
    \PYG{n}{image\PYGZus{}embedding} \PYG{o}{=} \PYG{n}{image\PYGZus{}embedding}\PYG{o}{.}\PYG{n}{view}\PYG{p}{(}\PYG{n}{image\PYGZus{}embedding}\PYG{o}{.}\PYG{n}{size}\PYG{p}{(}\PYG{l+m+mi}{0}\PYG{p}{),} \PYG{o}{\PYGZhy{}}\PYG{l+m+mi}{1}\PYG{p}{)}
    \PYG{n}{text\PYGZus{}embedding} \PYG{o}{=} \PYG{n}{text\PYGZus{}embedding}\PYG{o}{.}\PYG{n}{view}\PYG{p}{(}\PYG{n}{text\PYGZus{}embedding}\PYG{o}{.}\PYG{n}{size}\PYG{p}{(}\PYG{l+m+mi}{0}\PYG{p}{),} \PYG{o}{\PYGZhy{}}\PYG{l+m+mi}{1}\PYG{p}{)}

    \PYG{c+c1}{\PYGZsh{} Normalizar L2 (norma = 1)}
    \PYG{c+c1}{\PYGZsh{} +1e\PYGZhy{}8 para evitar división por cero}
    \PYG{n}{image\PYGZus{}embedding\PYGZus{}norm} \PYG{o}{=} \PYG{n}{image\PYGZus{}embedding} \PYG{o}{/} \PYG{p}{(}
        \PYG{n}{image\PYGZus{}embedding}\PYG{o}{.}\PYG{n}{norm}\PYG{p}{(}\PYG{n}{dim}\PYG{o}{=}\PYG{l+m+mi}{1}\PYG{p}{,} \PYG{n}{keepdim}\PYG{o}{=}\PYG{k+kc}{True}\PYG{p}{)} \PYG{o}{+} \PYG{l+m+mf}{1e\PYGZhy{}8}
    \PYG{p}{)}
    \PYG{n}{text\PYGZus{}embedding\PYGZus{}norm} \PYG{o}{=} \PYG{n}{text\PYGZus{}embedding} \PYG{o}{/} \PYG{p}{(}
        \PYG{n}{text\PYGZus{}embedding}\PYG{o}{.}\PYG{n}{norm}\PYG{p}{(}\PYG{n}{dim}\PYG{o}{=}\PYG{l+m+mi}{1}\PYG{p}{,} \PYG{n}{keepdim}\PYG{o}{=}\PYG{k+kc}{True}\PYG{p}{)} \PYG{o}{+} \PYG{l+m+mf}{1e\PYGZhy{}8}
    \PYG{p}{)}

    \PYG{c+c1}{\PYGZsh{} Producto matricial: similitud entre cada par (img\PYGZus{}i, txt\PYGZus{}j)}
    \PYG{n}{similarity} \PYG{o}{=} \PYG{n}{torch}\PYG{o}{.}\PYG{n}{mm}\PYG{p}{(}\PYG{n}{image\PYGZus{}embedding\PYGZus{}norm}\PYG{p}{,} \PYG{n}{text\PYGZus{}embedding\PYGZus{}norm}\PYG{o}{.}\PYG{n}{t}\PYG{p}{())}
    \PYG{k}{return} \PYG{n}{similarity}
\end{MintedVerbatim}
