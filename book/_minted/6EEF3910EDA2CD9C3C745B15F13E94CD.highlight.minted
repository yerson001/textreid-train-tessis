\begin{MintedVerbatim}[commandchars=\\\{\}]
\PYG{k}{def}\PYG{+w}{ }\PYG{n+nf}{evaluate}\PYG{p}{(}\PYG{n}{similarity}\PYG{p}{,} \PYG{n}{label\PYGZus{}query}\PYG{p}{,} \PYG{n}{label\PYGZus{}gallery}\PYG{p}{):}
\PYG{+w}{    }\PYG{l+s+sd}{\PYGZdq{}\PYGZdq{}\PYGZdq{}}
\PYG{l+s+sd}{    similarity:     matriz (N\PYGZus{}img, N\PYGZus{}txt) de similitud coseno}
\PYG{l+s+sd}{    label\PYGZus{}query:    vector (N\PYGZus{}txt,) con pids de los textos (queries)}
\PYG{l+s+sd}{    label\PYGZus{}gallery:  vector (N\PYGZus{}img,) con pids de las imágenes (gallery)}
\PYG{l+s+sd}{    Returns: (cmc, mAP)}
\PYG{l+s+sd}{    \PYGZdq{}\PYGZdq{}\PYGZdq{}}

    \PYG{c+c1}{\PYGZsh{} Convertir de torch.Tensor a numpy array}
    \PYG{n}{label\PYGZus{}query} \PYG{o}{=} \PYG{n}{label\PYGZus{}query}\PYG{o}{.}\PYG{n}{numpy}\PYG{p}{()}
    \PYG{n}{label\PYGZus{}gallery} \PYG{o}{=} \PYG{n}{label\PYGZus{}gallery}\PYG{o}{.}\PYG{n}{numpy}\PYG{p}{()}

    \PYG{c+c1}{\PYGZsh{} Vector acumulador de CMC}
    \PYG{c+c1}{\PYGZsh{} Tamaño = número de imágenes en la gallery}
    \PYG{c+c1}{\PYGZsh{} Cada posición k almacena cuántos queries acertaron en top\PYGZhy{}k}
    \PYG{n}{cmc} \PYG{o}{=} \PYG{n}{np}\PYG{o}{.}\PYG{n}{zeros}\PYG{p}{(}\PYG{n}{label\PYGZus{}gallery}\PYG{o}{.}\PYG{n}{shape}\PYG{p}{)}

    \PYG{c+c1}{\PYGZsh{} Acumulador de AP (para luego sacar promedio = mAP)}
    \PYG{n}{ap} \PYG{o}{=} \PYG{l+m+mi}{0}

    \PYG{c+c1}{\PYGZsh{} Para cada query de texto:}
    \PYG{k}{for} \PYG{n}{i} \PYG{o+ow}{in} \PYG{n+nb}{range}\PYG{p}{(}\PYG{n+nb}{len}\PYG{p}{(}\PYG{n}{label\PYGZus{}query}\PYG{p}{)):}

        \PYG{c+c1}{\PYGZsh{} Calcular AP para esta query}
        \PYG{c+c1}{\PYGZsh{} similarity[:, i] = columna i = similitud de TODAS las imágenes}
        \PYG{c+c1}{\PYGZsh{}                    con el texto i\PYGZhy{}ésimo (orden: filas son imágenes)}
        \PYG{n}{ap\PYGZus{}i}\PYG{p}{,} \PYG{n}{cmc\PYGZus{}i} \PYG{o}{=} \PYG{n}{calculate\PYGZus{}ap}\PYG{p}{(}
            \PYG{n}{similarity}\PYG{p}{[:,} \PYG{n}{i}\PYG{p}{],}
            \PYG{n}{label\PYGZus{}query}\PYG{p}{[}\PYG{n}{i}\PYG{p}{],}
            \PYG{n}{label\PYGZus{}gallery}\PYG{p}{)}

        \PYG{c+c1}{\PYGZsh{} Acumular cmc (suma de indicadores)}
        \PYG{n}{cmc} \PYG{o}{+=} \PYG{n}{cmc\PYGZus{}i}

        \PYG{c+c1}{\PYGZsh{} Acumular AP}
        \PYG{n}{ap} \PYG{o}{+=} \PYG{n}{ap\PYGZus{}i}

    \PYG{c+c1}{\PYGZsh{} Normalizar: cmc[k] = fracción de queries que acertaron en top\PYGZhy{}k}
    \PYG{n}{cmc} \PYG{o}{=} \PYG{n}{cmc} \PYG{o}{/} \PYG{n+nb}{len}\PYG{p}{(}\PYG{n}{label\PYGZus{}query}\PYG{p}{)}

    \PYG{c+c1}{\PYGZsh{} Normalizar: mAP = promedio de AP sobre todos los queries}
    \PYG{n+nb}{map} \PYG{o}{=} \PYG{n}{ap} \PYG{o}{/} \PYG{n+nb}{len}\PYG{p}{(}\PYG{n}{label\PYGZus{}query}\PYG{p}{)}

\PYG{+w}{    }\PYG{l+s+sd}{\PYGZdq{}\PYGZdq{}\PYGZdq{}}
\PYG{l+s+sd}{    Comentario sobre cmc:}
\PYG{l+s+sd}{    cmc[i] es un vector [0, 0, ..., 1, 1, ..., 1] donde el primer 1}
\PYG{l+s+sd}{    está en la posición del primer match correcto. rank\PYGZhy{}n y todos}
\PYG{l+s+sd}{    los ranks posteriores suman un acierto. Al sumar todos los}
\PYG{l+s+sd}{    vectores y dividir por n\PYGZus{}query obtenemos el rank\PYGZhy{}k accuracy.}
\PYG{l+s+sd}{    \PYGZdq{}\PYGZdq{}\PYGZdq{}}

    \PYG{k}{return} \PYG{n}{cmc}\PYG{p}{,} \PYG{n+nb}{map}
\end{MintedVerbatim}
