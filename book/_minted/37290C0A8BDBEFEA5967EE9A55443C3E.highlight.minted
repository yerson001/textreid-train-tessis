\PYG{k}{class}\PYG{+w}{ }\PYG{n+nc}{GRULanguageNetwork}\PYG{p}{(}\PYG{n}{nn}\PYG{o}{.}\PYG{n}{Module}\PYG{p}{):}
\PYG{+w}{    }\PYG{l+s+sd}{\PYGZdq{}\PYGZdq{}\PYGZdq{}Embedding + Dropout + GRU bidireccional.\PYGZdq{}\PYGZdq{}\PYGZdq{}}

    \PYG{k}{def}\PYG{+w}{ }\PYG{n+nf+fm}{\PYGZus{}\PYGZus{}init\PYGZus{}\PYGZus{}}\PYG{p}{(}\PYG{n+nb+bp}{self}\PYG{p}{,} \PYG{n}{config}\PYG{o}{=}\PYG{k+kc}{None}\PYG{p}{):}
        \PYG{n+nb}{super}\PYG{p}{(}\PYG{n}{GRULanguageNetwork}\PYG{p}{,} \PYG{n+nb+bp}{self}\PYG{p}{)}\PYG{o}{.}\PYG{n+nf+fm}{\PYGZus{}\PYGZus{}init\PYGZus{}\PYGZus{}}\PYG{p}{()}
        \PYG{k}{if} \PYG{n}{config} \PYG{o+ow}{is} \PYG{k+kc}{None}\PYG{p}{:}
            \PYG{k}{raise} \PYG{n+ne}{ValueError}\PYG{p}{(}\PYG{l+s+s2}{\PYGZdq{}`config` can not be none\PYGZdq{}}\PYG{p}{)}

        \PYG{c+c1}{\PYGZsh{} Capa de embedding}
        \PYG{c+c1}{\PYGZsh{} vocab\PYGZus{}size = 29609 (BERT) + 1 (padding) = 29610}
        \PYG{c+c1}{\PYGZsh{} embedding\PYGZus{}dim = 512}
        \PYG{c+c1}{\PYGZsh{} padding\PYGZus{}idx = 0: el vector para índice 0 se mantiene en 0}
        \PYG{n+nb+bp}{self}\PYG{o}{.}\PYG{n}{embedding} \PYG{o}{=} \PYG{n}{nn}\PYG{o}{.}\PYG{n}{Embedding}\PYG{p}{(}
            \PYG{n}{config}\PYG{o}{.}\PYG{n}{vocab\PYGZus{}size}\PYG{p}{,}        \PYG{c+c1}{\PYGZsh{} 29610}
            \PYG{n}{config}\PYG{o}{.}\PYG{n}{embedding\PYGZus{}dim}\PYG{p}{,}     \PYG{c+c1}{\PYGZsh{} 512}
            \PYG{n}{padding\PYGZus{}idx}\PYG{o}{=}\PYG{l+m+mi}{0}
        \PYG{p}{)}

        \PYG{c+c1}{\PYGZsh{} Dropout tras el embedding (30\PYGZpc{})}
        \PYG{n+nb+bp}{self}\PYG{o}{.}\PYG{n}{dropout} \PYG{o}{=} \PYG{n}{nn}\PYG{o}{.}\PYG{n}{Dropout}\PYG{p}{(}\PYG{n}{config}\PYG{o}{.}\PYG{n}{dropout\PYGZus{}rate}\PYG{p}{)}  \PYG{c+c1}{\PYGZsh{} 0.30}

        \PYG{c+c1}{\PYGZsh{} GRU bidireccional}
        \PYG{c+c1}{\PYGZsh{} input\PYGZus{}size: 512 (dim del embedding)}
        \PYG{c+c1}{\PYGZsh{} hidden\PYGZus{}size: 1024 (feature\PYGZus{}length)}
        \PYG{c+c1}{\PYGZsh{} num\PYGZus{}layers: 1}
        \PYG{c+c1}{\PYGZsh{} bidirectional=True: procesa en ambas direcciones}
        \PYG{c+c1}{\PYGZsh{} bias=False: ahorra parámetros}
        \PYG{n+nb+bp}{self}\PYG{o}{.}\PYG{n}{gru} \PYG{o}{=} \PYG{n}{nn}\PYG{o}{.}\PYG{n}{GRU}\PYG{p}{(}
            \PYG{n}{config}\PYG{o}{.}\PYG{n}{embedding\PYGZus{}dim}\PYG{p}{,}     \PYG{c+c1}{\PYGZsh{} 512}
            \PYG{n}{config}\PYG{o}{.}\PYG{n}{feature\PYGZus{}length}\PYG{p}{,}    \PYG{c+c1}{\PYGZsh{} 1024}
            \PYG{n}{num\PYGZus{}layers}\PYG{o}{=}\PYG{n}{config}\PYG{o}{.}\PYG{n}{num\PYGZus{}layers}\PYG{p}{,}    \PYG{c+c1}{\PYGZsh{} 1}
            \PYG{n}{bidirectional}\PYG{o}{=}\PYG{k+kc}{True}\PYG{p}{,}
            \PYG{n}{bias}\PYG{o}{=}\PYG{k+kc}{False}
        \PYG{p}{)}

    \PYG{k}{def}\PYG{+w}{ }\PYG{n+nf}{forward}\PYG{p}{(}\PYG{n+nb+bp}{self}\PYG{p}{,} \PYG{n}{text\PYGZus{}ids}\PYG{o}{=}\PYG{k+kc}{None}\PYG{p}{,} \PYG{n}{text\PYGZus{}length}\PYG{o}{=}\PYG{k+kc}{None}\PYG{p}{):}
\PYG{+w}{        }\PYG{l+s+sd}{\PYGZdq{}\PYGZdq{}\PYGZdq{}text\PYGZus{}ids: (B, 100), text\PYGZus{}length: (B,).}
\PYG{l+s+sd}{           returns: (B, 1024, 100, 1)\PYGZdq{}\PYGZdq{}\PYGZdq{}}
        \PYG{c+c1}{\PYGZsh{} 1. Embedding: (B, 100) \PYGZhy{}\PYGZgt{} (B, 100, 512)}
        \PYG{n}{text\PYGZus{}embedding} \PYG{o}{=} \PYG{n+nb+bp}{self}\PYG{o}{.}\PYG{n}{embedding}\PYG{p}{(}\PYG{n}{text\PYGZus{}ids}\PYG{p}{)}
        \PYG{c+c1}{\PYGZsh{} 2. Dropout (solo en training mode)}
        \PYG{n}{text\PYGZus{}embedding} \PYG{o}{=} \PYG{n+nb+bp}{self}\PYG{o}{.}\PYG{n}{dropout}\PYG{p}{(}\PYG{n}{text\PYGZus{}embedding}\PYG{p}{)}
        \PYG{c+c1}{\PYGZsh{} 3. Procesar con BiGRU (usando pack\PYGZus{}padded\PYGZus{}sequence)}
        \PYG{n}{feature} \PYG{o}{=} \PYG{n+nb+bp}{self}\PYG{o}{.}\PYG{n}{do\PYGZus{}RNN\PYGZus{}computation}\PYG{p}{(}\PYG{n}{text\PYGZus{}embedding}\PYG{p}{,} \PYG{n}{text\PYGZus{}length}\PYG{p}{,} \PYG{n+nb+bp}{self}\PYG{o}{.}\PYG{n}{gru}\PYG{p}{)}
        \PYG{k}{return} \PYG{n}{feature}
\end{MintedVerbatim}
