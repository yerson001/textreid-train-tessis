\begin{MintedVerbatim}[commandchars=\\\{\}]
\PYG{k}{class}\PYG{+w}{ }\PYG{n+nc}{VisualNetwork}\PYG{p}{(}\PYG{n}{nn}\PYG{o}{.}\PYG{n}{Module}\PYG{p}{):}
\PYG{+w}{    }\PYG{l+s+sd}{\PYGZdq{}\PYGZdq{}\PYGZdq{}Backbone visual: EfficientNet\PYGZhy{}B0 preentrenado.\PYGZdq{}\PYGZdq{}\PYGZdq{}}

    \PYG{k}{def}\PYG{+w}{ }\PYG{n+nf+fm}{\PYGZus{}\PYGZus{}init\PYGZus{}\PYGZus{}}\PYG{p}{(}\PYG{n+nb+bp}{self}\PYG{p}{):}
        \PYG{c+c1}{\PYGZsh{} Constructor de nn.Module (registra parámetros)}
        \PYG{n+nb}{super}\PYG{p}{(}\PYG{n}{VisualNetwork}\PYG{p}{,} \PYG{n+nb+bp}{self}\PYG{p}{)}\PYG{o}{.}\PYG{n+nf+fm}{\PYGZus{}\PYGZus{}init\PYGZus{}\PYGZus{}}\PYG{p}{()}

        \PYG{c+c1}{\PYGZsh{} Cargar EfficientNet\PYGZhy{}B0 con pesos preentrenados en ImageNet}
        \PYG{c+c1}{\PYGZsh{} EfficientNet\PYGZus{}B0\PYGZus{}Weights.DEFAULT = mejores pesos disponibles}
        \PYG{c+c1}{\PYGZsh{} (\PYGZti{}5.3M parámetros, input esperado 224x224)}
        \PYG{n+nb+bp}{self}\PYG{o}{.}\PYG{n}{model} \PYG{o}{=} \PYG{n}{models}\PYG{o}{.}\PYG{n}{efficientnet\PYGZus{}b0}\PYG{p}{(}
            \PYG{n}{weights}\PYG{o}{=}\PYG{n}{EfficientNet\PYGZus{}B0\PYGZus{}Weights}\PYG{o}{.}\PYG{n}{DEFAULT}
        \PYG{p}{)}

        \PYG{c+c1}{\PYGZsh{} `model.features` es un nn.Sequential con 9 bloques}
        \PYG{c+c1}{\PYGZsh{} (ver Tabla 6.1). Vamos a iterar bloque por bloque.}
        \PYG{n+nb+bp}{self}\PYG{o}{.}\PYG{n}{feature\PYGZus{}blocks} \PYG{o}{=} \PYG{n+nb+bp}{self}\PYG{o}{.}\PYG{n}{model}\PYG{o}{.}\PYG{n}{features}

    \PYG{k}{def}\PYG{+w}{ }\PYG{n+nf}{forward}\PYG{p}{(}\PYG{n+nb+bp}{self}\PYG{p}{,} \PYG{n}{x}\PYG{p}{):}
\PYG{+w}{        }\PYG{l+s+sd}{\PYGZdq{}\PYGZdq{}\PYGZdq{}x: (B, 3, H, W) imagen preprocesada.}
\PYG{l+s+sd}{           returns: (B, 1280, H/32, W/32) salida etapa 9.\PYGZdq{}\PYGZdq{}\PYGZdq{}}
        \PYG{c+c1}{\PYGZsh{} Lista para acumular features de cada bloque}
        \PYG{n}{features} \PYG{o}{=} \PYG{p}{[]}

        \PYG{c+c1}{\PYGZsh{} Iterar sobre los 9 bloques secuenciales de EfficientNet\PYGZhy{}B0}
        \PYG{k}{for} \PYG{n}{block} \PYG{o+ow}{in} \PYG{n+nb+bp}{self}\PYG{o}{.}\PYG{n}{feature\PYGZus{}blocks}\PYG{p}{:}
            \PYG{c+c1}{\PYGZsh{} Aplicar bloque (conv + BN + activation)}
            \PYG{n}{x} \PYG{o}{=} \PYG{n}{block}\PYG{p}{(}\PYG{n}{x}\PYG{p}{)}

            \PYG{c+c1}{\PYGZsh{} Guardar feature de este bloque}
            \PYG{n}{features}\PYG{o}{.}\PYG{n}{append}\PYG{p}{(}\PYG{n}{x}\PYG{p}{)}

        \PYG{c+c1}{\PYGZsh{} Devolver SOLO la salida del último bloque (etapa 9)}
        \PYG{c+c1}{\PYGZsh{} = 1280 canales, resolución espacial /32}
        \PYG{k}{return} \PYG{n}{features}\PYG{p}{[}\PYG{o}{\PYGZhy{}}\PYG{l+m+mi}{1}\PYG{p}{]}
