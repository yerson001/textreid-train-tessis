\PYG{c+c1}{\PYGZsh{} \PYGZhy{}\PYGZgt{} (B, 1280, 16, 16)  \PYGZlt{}\PYGZhy{} etapa 9, depende del tamaño de entrada}

\PYG{c+c1}{\PYGZsh{} DSC 1280 \PYGZhy{}\PYGZgt{} 1024}
