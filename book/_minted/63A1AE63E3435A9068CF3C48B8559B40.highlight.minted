\begin{MintedVerbatim}[commandchars=\\\{\}]
\PYG{c+c1}{\PYGZsh{} Entrada: imagen preprocesada (normalizada)}
\PYG{n}{x}\PYG{p}{:}  \PYG{p}{(}\PYG{n}{B}\PYG{p}{,} \PYG{l+m+mi}{3}\PYG{p}{,} \PYG{l+m+mi}{512}\PYG{p}{,} \PYG{l+m+mi}{512}\PYG{p}{)}

\PYG{c+c1}{\PYGZsh{} EfficientNet\PYGZhy{}B0}
