\begin{MintedVerbatim}[commandchars=\\\{\}]
    \PYG{k}{def}\PYG{+w}{ }\PYG{n+nf}{image\PYGZus{}embedding}\PYG{p}{(}\PYG{n+nb+bp}{self}\PYG{p}{,} \PYG{n}{image}\PYG{o}{=}\PYG{k+kc}{None}\PYG{p}{):}
\PYG{+w}{        }\PYG{l+s+sd}{\PYGZdq{}\PYGZdq{}\PYGZdq{}image: (B, 3, H, W) batch de imágenes.}
\PYG{l+s+sd}{           returns: (B, 1024, 1) embeddings visuales.\PYGZdq{}\PYGZdq{}\PYGZdq{}}

        \PYG{c+c1}{\PYGZsh{} PASO 1: EfficientNet\PYGZhy{}B0}
        \PYG{c+c1}{\PYGZsh{} Entrada: (B, 3, 512, 512)}
        \PYG{c+c1}{\PYGZsh{} Salida: (B, 1280, 16, 16) \PYGZlt{}\PYGZhy{} última etapa}
        \PYG{n}{visual\PYGZus{}features} \PYG{o}{=} \PYG{n+nb+bp}{self}\PYG{o}{.}\PYG{n}{visual\PYGZus{}network}\PYG{p}{(}\PYG{n}{image}\PYG{p}{)}

        \PYG{c+c1}{\PYGZsh{} PASO 2: DSC 1280 \PYGZhy{}\PYGZgt{} 1024}
        \PYG{c+c1}{\PYGZsh{} Entrada: (B, 1280, 16, 16)}
        \PYG{c+c1}{\PYGZsh{} Salida:  (B, 1024, 16, 16)}
        \PYG{n}{visual\PYGZus{}features} \PYG{o}{=} \PYG{n+nb+bp}{self}\PYG{o}{.}\PYG{n}{visual\PYGZus{}features\PYGZus{}downscale}\PYG{p}{(}\PYG{n}{visual\PYGZus{}features}\PYG{p}{)}

        \PYG{c+c1}{\PYGZsh{} PASO 3: Adaptive Max Pooling}
        \PYG{c+c1}{\PYGZsh{} Entrada: (B, 1024, 16, 16)}
        \PYG{c+c1}{\PYGZsh{} Salida:  (B, 1024, 1, 1)}
        \PYG{n}{visual\PYGZus{}features} \PYG{o}{=} \PYG{n+nb+bp}{self}\PYG{o}{.}\PYG{n}{adaptive\PYGZus{}max\PYGZus{}pooling}\PYG{p}{(}\PYG{n}{visual\PYGZus{}features}\PYG{p}{)}

        \PYG{c+c1}{\PYGZsh{} PASO 4: DSC final 1024 \PYGZhy{}\PYGZgt{} 1024 (compartido con texto)}
        \PYG{c+c1}{\PYGZsh{} Entrada: (B, 1024, 1, 1)}
        \PYG{c+c1}{\PYGZsh{} Salida:  (B, 1024, 1, 1)}
        \PYG{n}{visual\PYGZus{}features} \PYG{o}{=} \PYG{n+nb+bp}{self}\PYG{o}{.}\PYG{n}{depthwise\PYGZus{}seperable\PYGZus{}convolution}\PYG{p}{(}\PYG{n}{visual\PYGZus{}features}\PYG{p}{)}

        \PYG{c+c1}{\PYGZsh{} PASO 5: squeeze + contiguous}
        \PYG{c+c1}{\PYGZsh{} .squeeze(\PYGZhy{}1) elimina la última dim (1) \PYGZhy{}\PYGZgt{} (B, 1024, 1)}
        \PYG{c+c1}{\PYGZsh{} .contiguous() asegura memoria contigua}
        \PYG{n}{visual\PYGZus{}features} \PYG{o}{=} \PYG{n}{visual\PYGZus{}features}\PYG{o}{.}\PYG{n}{squeeze}\PYG{p}{(}\PYG{o}{\PYGZhy{}}\PYG{l+m+mi}{1}\PYG{p}{)}\PYG{o}{.}\PYG{n}{contiguous}\PYG{p}{()}
        \PYG{k}{return} \PYG{n}{visual\PYGZus{}features}
\end{MintedVerbatim}
