    \PYG{k}{def}\PYG{+w}{ }\PYG{n+nf}{forward}\PYG{p}{(}\PYG{n+nb+bp}{self}\PYG{p}{,} \PYG{n}{image}\PYG{p}{,} \PYG{n}{text\PYGZus{}ids}\PYG{o}{=}\PYG{k+kc}{None}\PYG{p}{,} \PYG{n}{text\PYGZus{}length}\PYG{o}{=}\PYG{k+kc}{None}\PYG{p}{):}
\PYG{+w}{        }\PYG{l+s+sd}{\PYGZdq{}\PYGZdq{}\PYGZdq{}image: (B,3,H,W), text\PYGZus{}ids: (B,100), text\PYGZus{}length: (B,)}
\PYG{l+s+sd}{           returns: ((B,1024,1), (B,1024,1))\PYGZdq{}\PYGZdq{}\PYGZdq{}}
        \PYG{c+c1}{\PYGZsh{} Calcular embedding visual (rama izquierda)}
        \PYG{n}{visaual\PYGZus{}embeddings} \PYG{o}{=} \PYG{n+nb+bp}{self}\PYG{o}{.}\PYG{n}{image\PYGZus{}embedding}\PYG{p}{(}\PYG{n}{image}\PYG{p}{)}

        \PYG{c+c1}{\PYGZsh{} Calcular embedding textual (rama derecha)}
        \PYG{n}{textual\PYGZus{}embeddings} \PYG{o}{=} \PYG{n+nb+bp}{self}\PYG{o}{.}\PYG{n}{text\PYGZus{}embedding}\PYG{p}{(}\PYG{n}{text\PYGZus{}ids}\PYG{p}{,} \PYG{n}{text\PYGZus{}length}\PYG{p}{)}

        \PYG{c+c1}{\PYGZsh{} Devolver ambos. train.py los aplana a (B, 1024) con view(\PYGZhy{}1).}
        \PYG{c+c1}{\PYGZsh{} Nota: hay un typo en el código: \PYGZdq{}visaual\PYGZdq{} en lugar de \PYGZdq{}visual\PYGZdq{}}
        \PYG{k}{return} \PYG{n}{visaual\PYGZus{}embeddings}\PYG{p}{,} \PYG{n}{textual\PYGZus{}embeddings}
