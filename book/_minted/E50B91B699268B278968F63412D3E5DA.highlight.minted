    \PYG{k}{def}\PYG{+w}{ }\PYG{n+nf}{do\PYGZus{}RNN\PYGZus{}computation}\PYG{p}{(}\PYG{n+nb+bp}{self}\PYG{p}{,} \PYG{n}{text\PYGZus{}embedding}\PYG{p}{,} \PYG{n}{text\PYGZus{}length}\PYG{p}{,} \PYG{n}{gru}\PYG{p}{):}
\PYG{+w}{        }\PYG{l+s+sd}{\PYGZdq{}\PYGZdq{}\PYGZdq{}Procesa la secuencia con GRU usando pack\PYGZus{}padded\PYGZus{}sequence.\PYGZdq{}\PYGZdq{}\PYGZdq{}}

        \PYG{c+c1}{\PYGZsh{} Asegurar que text\PYGZus{}length es 1\PYGZhy{}D}
        \PYG{n}{text\PYGZus{}length} \PYG{o}{=} \PYG{n}{text\PYGZus{}length}\PYG{o}{.}\PYG{n}{view}\PYG{p}{(}\PYG{o}{\PYGZhy{}}\PYG{l+m+mi}{1}\PYG{p}{)}

        \PYG{c+c1}{\PYGZsh{} Ordenar índices por longitud DESCENDENTE}
        \PYG{n}{\PYGZus{}}\PYG{p}{,} \PYG{n}{sort\PYGZus{}index} \PYG{o}{=} \PYG{n}{torch}\PYG{o}{.}\PYG{n}{sort}\PYG{p}{(}\PYG{n}{text\PYGZus{}length}\PYG{p}{,} \PYG{n}{dim}\PYG{o}{=}\PYG{l+m+mi}{0}\PYG{p}{,} \PYG{n}{descending}\PYG{o}{=}\PYG{k+kc}{True}\PYG{p}{)}

        \PYG{c+c1}{\PYGZsh{} Invertir el orden: nos servirá para \PYGZdq{}des\PYGZhy{}ordenar\PYGZdq{} después}
        \PYG{n}{\PYGZus{}}\PYG{p}{,} \PYG{n}{unsort\PYGZus{}index} \PYG{o}{=} \PYG{n}{sort\PYGZus{}index}\PYG{o}{.}\PYG{n}{sort}\PYG{p}{()}

        \PYG{c+c1}{\PYGZsh{} Reordenar el batch por longitud descendente}
        \PYG{n}{sortlength\PYGZus{}text\PYGZus{}embedding} \PYG{o}{=} \PYG{n}{text\PYGZus{}embedding}\PYG{p}{[}\PYG{n}{sort\PYGZus{}index}\PYG{p}{,} \PYG{p}{:]}
        \PYG{n}{sort\PYGZus{}text\PYGZus{}length} \PYG{o}{=} \PYG{n}{text\PYGZus{}length}\PYG{p}{[}\PYG{n}{sort\PYGZus{}index}\PYG{p}{]}

        \PYG{c+c1}{\PYGZsh{} Empaquetar: ignora el padding en el cómputo de la GRU}
        \PYG{n}{packed\PYGZus{}text\PYGZus{}embedding} \PYG{o}{=} \PYG{n}{pack\PYGZus{}padded\PYGZus{}sequence}\PYG{p}{(}
            \PYG{n}{sortlength\PYGZus{}text\PYGZus{}embedding}\PYG{p}{,}
            \PYG{n}{sort\PYGZus{}text\PYGZus{}length}\PYG{o}{.}\PYG{n}{cpu}\PYG{p}{(),}
            \PYG{n}{batch\PYGZus{}first}\PYG{o}{=}\PYG{k+kc}{True}
        \PYG{p}{)}

        \PYG{c+c1}{\PYGZsh{} Pasar por la GRU}
        \PYG{n}{packed\PYGZus{}feature}\PYG{p}{,} \PYG{n}{hn} \PYG{o}{=} \PYG{n}{gru}\PYG{p}{(}\PYG{n}{packed\PYGZus{}text\PYGZus{}embedding}\PYG{p}{)}

        \PYG{c+c1}{\PYGZsh{} Desempaquetar: vuelve a la forma (B, T, *)}
        \PYG{n}{total\PYGZus{}length} \PYG{o}{=} \PYG{n}{text\PYGZus{}embedding}\PYG{o}{.}\PYG{n}{size}\PYG{p}{(}\PYG{l+m+mi}{1}\PYG{p}{)}
        \PYG{n}{sort\PYGZus{}feature} \PYG{o}{=} \PYG{n}{pad\PYGZus{}packed\PYGZus{}sequence}\PYG{p}{(}
            \PYG{n}{packed\PYGZus{}feature}\PYG{p}{,} \PYG{n}{batch\PYGZus{}first}\PYG{o}{=}\PYG{k+kc}{True}\PYG{p}{,} \PYG{n}{total\PYGZus{}length}\PYG{o}{=}\PYG{n}{total\PYGZus{}length}
        \PYG{p}{)}

        \PYG{c+c1}{\PYGZsh{} Des\PYGZhy{}ordenar: volver al orden original del batch}
        \PYG{n}{unsort\PYGZus{}feature} \PYG{o}{=} \PYG{n}{sort\PYGZus{}feature}\PYG{p}{[}\PYG{l+m+mi}{0}\PYG{p}{][}\PYG{n}{unsort\PYGZus{}index}\PYG{p}{,} \PYG{p}{:]}

        \PYG{c+c1}{\PYGZsh{} Promediar fwd y bwd:}
        \PYG{c+c1}{\PYGZsh{} BiGRU output: (B, T, 2*hidden) = (B, 100, 2048)}
        \PYG{c+c1}{\PYGZsh{} [:, :, :1024] = forward, [:, :, 1024:] = backward}
        \PYG{n}{unsort\PYGZus{}feature} \PYG{o}{=} \PYG{p}{(}
            \PYG{n}{unsort\PYGZus{}feature}\PYG{p}{[:,} \PYG{p}{:,} \PYG{p}{:}\PYG{n+nb}{int}\PYG{p}{(}\PYG{n}{unsort\PYGZus{}feature}\PYG{o}{.}\PYG{n}{size}\PYG{p}{(}\PYG{l+m+mi}{2}\PYG{p}{)} \PYG{o}{/} \PYG{l+m+mi}{2}\PYG{p}{)]} \PYG{o}{+}
            \PYG{n}{unsort\PYGZus{}feature}\PYG{p}{[:,} \PYG{p}{:,} \PYG{n+nb}{int}\PYG{p}{(}\PYG{n}{unsort\PYGZus{}feature}\PYG{o}{.}\PYG{n}{size}\PYG{p}{(}\PYG{l+m+mi}{2}\PYG{p}{)} \PYG{o}{/} \PYG{l+m+mi}{2}\PYG{p}{):]}
        \PYG{p}{)} \PYG{o}{/} \PYG{l+m+mi}{2}

        \PYG{c+c1}{\PYGZsh{} Preparar para alimentar el DSC final:}
        \PYG{c+c1}{\PYGZsh{} permute(0,2,1): (B, 100, 1024) \PYGZhy{}\PYGZgt{} (B, 1024, 100)}
        \PYG{c+c1}{\PYGZsh{} unsqueeze(3): añadir dim al final \PYGZhy{}\PYGZgt{} (B, 1024, 100, 1)}
        \PYG{k}{return} \PYG{n}{unsort\PYGZus{}feature}\PYG{o}{.}\PYG{n}{permute}\PYG{p}{(}\PYG{l+m+mi}{0}\PYG{p}{,} \PYG{l+m+mi}{2}\PYG{p}{,} \PYG{l+m+mi}{1}\PYG{p}{)}\PYG{o}{.}\PYG{n}{contiguous}\PYG{p}{()}\PYG{o}{.}\PYG{n}{unsqueeze}\PYG{p}{(}\PYG{l+m+mi}{3}\PYG{p}{)}
